{
  "name": "zavod",
  "version": "1.0.0",
  "main": "index.js",
  "files": [
    "index.html",
    "favicon.svg",
    "src/",
    "assets/",
    "assets-m/",
    "vendor/three/",
    "vendor/three-mesh-bvh/",
    "vercel.json",
    "manifest.webmanifest",
    "sw.js",
    "icons/",
    "precache.json"
  ],
  "scripts": {
    "serve": "./qa/serve.sh",
    "test:review": "node qa/review-test.mjs",
    "test:maplab": "xvfb-run -a -s '-screen 0 1600x1200x24' env QA_VIRTUAL_DISPLAY=1 node qa/map-lab-game-test.mjs",
    "release:maplab": "xvfb-run -a -s '-screen 0 1600x1200x24' env QA_VIRTUAL_DISPLAY=1 node tools/maplab-release.mjs",
    "test:benchmark-isolation": "node --experimental-vm-modules qa/map-lab/tests/benchmark-isolation-test.mjs",
    "benchmark:overhead": "node qa/map-lab/tests/benchmark-overhead.mjs",
    "test": "for t in chill crews deli locals fight jobs guns fun; do node qa/$t-test.mjs || exit 1; done"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "ZAVOD \u2014 browser FPS in Three.js; Coney Island hangout with friends (MQTT multiplayer)",
  "dependencies": {
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "iwer": "^2.5.0",
    "playwright-core": "^1.61.1"
  }
}
